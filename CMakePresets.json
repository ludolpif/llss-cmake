{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "include": [
  ],
  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "displayName": "Common definitions",
      "description": "Common definitions for other presets",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
      },
      "environment": {
      },
      "vendor": {
      }
    },
    {
      "name": "Darwin",
      "inherits": "common",
      "displayName": "MacOS (Darwin) XCode Multi-Config",
      "description": "Default MacOS (Darwin) build using XCode generator",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "generator": "Xcode"
    },
    {
      "name": "Linux",
      "inherits": "common",
      "displayName": "Linux Ninja Multi-Config",
      "description": "Default linux build using Ninja Multi-Config generator",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "Windows",
      "inherits": "common",
      "displayName": "Windows Visual Studio 18 2026",
      "description": "Default Windows build using Visual Studio 18 2026 generator",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build"
    }
  ],
  "buildPresets": [
    {
      "name": "Darwin",
      "configurePreset": "Darwin"
    },
    {
      "name": "Linux",
      "configurePreset": "Linux"
    },
    {
      "name": "Windows",
      "configurePreset": "Windows"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "common",
      "output": { "outputOnFailure": true },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    }
  ],
  "packagePresets": [
    {
      "name": "default",
      "configurePreset": "common",
      "generators": [
        "TGZ"
      ]
    }
  ]
}
