DMON_COMMIT="89d46c52c4a692ae5147ca4db1f1b69cfb8453e3"

sources() {
	set -xe
	rm -rf dmon
	mkdir dmon
	rawbase=https://raw.githubusercontent.com/septag/dmon/$DMON_COMMIT
	curl -Lfo dmon/LICENSE $rawbase/LICENSE
	curl -Lfo dmon/dmon.h $rawbase/dmon.h
	curl -Lfo dmon/dmon_extra.h $rawbase/dmon_extra.h
	ls -l dmon
}
_usage() {
	echo "Usage $0 --sources" >&2
	exit 1
}
case "$1" in
	--sources) sources ;;
	*) _usage ;;
esac

